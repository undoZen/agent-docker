# 复制成 .env：cp .env.example .env
# 这个文件只管运行时；镜像构建参数在仓库根目录的 Makefile 里（make base WITH_RUST=0）

# 宿主机上映射的端口，只监听 127.0.0.1，用于本地 Web UI
MIRASIM_HOST_PORT=4939

TZ=Asia/Shanghai

# 一般不用改，除非你给 base 镜像换了别的 tag
BASE_IMAGE=agent-docker:1
MIRASIM_TAG=agent-docker-mirasim:1

# 容器内 uid/gid 不在这里配。它在构建时就固化进镜像了（make base 默认用 id -u / id -g），
# 运行时自动继承，改这里没有任何作用 —— 要改就重建：
#   make base AGENT_UID=1000 AGENT_GID=1000 && make mirasim
